# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. On Vercel, set the same four in
# Project -> Settings -> Environment Variables. Never commit the filled copy.
# ---------------------------------------------------------------------------

# The secret door. Anything unguessable; generate one with:
#   openssl rand -hex 32
# You open https://<your-app>/d/<this value> once per device. That sets a
# year-long cookie and redirects to /, so the secret stops riding in the URL.
# Keep the full link in a password manager: clearing cookies is the only way
# to need it again.
DASHBOARD_TOKEN=

# Neon Postgres. Neon dashboard -> your project -> Connection string
# (the pooled one, ending in -pooler). Must include ?sslmode=require
DATABASE_URL=

# Google Calendar, read-only, no OAuth.
#
# ONE URL PER CALENDAR, separated by commas (or newlines). There is no
# combined feed -- Google publishes a separate secret address per calendar.
# Pick the two to four you actually need to see in the morning; the phone
# column caps the schedule at 42% of the screen, so more than that buries
# the to-dos.
#
# Google Calendar -> gear -> Settings -> click a calendar in the left sidebar
#   -> "Integrate calendar" -> "Secret address in iCal format" -> copy.
#
# Treat each as a password: anyone holding one can read that whole calendar.
# If one leaks, hit "Reset" on that same screen and paste the new one.
#
# CALENDAR_ICS_URL=https://.../personal/basic.ics,https://.../uni/basic.ics
CALENDAR_ICS_URL=

# Anthropic, for the weekly summary. console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Your Google account email. Only used to drop events you have declined:
# an .ics attendee line has to match this address for its PARTSTAT=DECLINED
# to count. Leave unset and no attendee-based filtering happens at all.
# CALENDAR_OWNER_EMAIL=
